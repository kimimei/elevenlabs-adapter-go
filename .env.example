# ---------------------------------------------------------------
# 变量名与默认值必须与 Python 版一致。改名字等于把存量部署的 .env
# 变成静默失效：值读不到就用默认值，程序不报错，行为却变了。
# ---------------------------------------------------------------

# --- 上游 ---
ELEVENLABS_API_BASE=https://api.elevenlabs.io/v1
# 兜底 Key。主路径是请求头透传（面板把渠道密钥放在 Authorization: Bearer sk_xxx）
ELEVENLABS_API_KEY=
# =1 时不发真实请求，返回 1 秒静音 WAV。仅用于链路自测，不消耗额度
ELEVENLABS_MOCK=0
# 外部音色表路径。留空用内置 voices.json（已打进二进制）
ELEVENLABS_VOICES_FILE=
ELEVENLABS_DEFAULT_MODEL=eleven_multilingual_v2
# 单次上游超时（秒）。实测约 33ms/字，300s 覆盖约 8000 字
ELEVENLABS_TIMEOUT=300
# 只对 5xx / 429 / 连接中断重试。⚠️ 超时永不重试（上游已完成合成，重试=重复扣费）
ELEVENLABS_MAX_RETRIES=0

# --- 服务 ---
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=8123
# 单次请求字符上限，0 = 不限。按「实际送合成的长度」判断
ADAPTER_MAX_CHARS=0
# 请求体上限（字节）。没有这个，一个超大 POST 就能把内存打满
ADAPTER_MAX_BODY_BYTES=2097152
# 同时处理请求数上限，0 = 不限。上游按并发限流，放太多只会挨个 429
ADAPTER_MAX_CONCURRENCY=0
# 来源 IP 白名单，逗号分隔。填的是 **TCP 对端地址**，不读 X-Forwarded-For：
# 反代转发时这里看到的是反代自己的地址（同机 127.0.0.1、容器网关 172.17.0.1）
ADAPTER_ALLOW_IPS=
# =1 时允许回落到 ~/.elevenlabs/config.json 的明文 Key（共享主机上很危险，默认关）
ADAPTER_ALLOW_LOCAL_KEY=0
# 补充包：none（默认，只暴露 5 个标准引擎）/ all / compat,en,cn,tw
ADAPTER_PRESETS=none
# 静态页外部目录覆盖（Go 版新增）。留空用内置页面
ADAPTER_STATIC_DIR=

# --- 长文本异步任务 ---
# 任务表落盘：进程重启后任务不会消失（Python 版会丢，客户轮询拿 404）
ADAPTER_JOBS_ENABLED=0
# 并发 worker 数 = 同时打到上游的请求数（上游按套餐限并发）
ADAPTER_JOBS_WORKERS=2
# 排队上限，超出返回 429 + Retry-After；<=0 视为不限
ADAPTER_JOBS_MAX_PENDING=50
# 单任务字符上限（按清理后的长度判断）
ADAPTER_JOBS_MAX_CHARS=8000
# 结果保留时长（秒），到期删元数据与音频
ADAPTER_JOBS_TTL_SECONDS=1800
# 任务表目录。⚠️ 必须可写：开关打开时目录不可写会导致启动失败（不假装「重启不丢」）
ADAPTER_JOBS_DIR=logs/jobs

# --- 在线试听（demo）---
# 用的是服务端 Key，等于把额度公开。四道闸门：默认关 / 单次字符上限 / 每 IP 每小时次数 / 音色白名单
ADAPTER_DEMO_ENABLED=0
ADAPTER_DEMO_MAX_CHARS=20
ADAPTER_DEMO_PER_HOUR=20
# 白名单音色（voices.json 里的名字）。留空或只写逗号会回落到默认并打 WARN
ADAPTER_DEMO_VOICES=zh-yingshi,zh-boyin,zh-pangbai
# =1 时信任 X-Forwarded-For 作为来源 IP。
# ⚠️ 挂在自己的 nginx 后面必须开，否则所有人都是 127.0.0.1，限额变成全站共享；
#    直接暴露公网时绝不能开（客户端可伪造）。
ADAPTER_DEMO_TRUST_XFF=0

# --- 计费账本 ---
# input    = 按客户提交的原始字符数计费（与 new-api 的 RuneCount(input) 逐笔相等）★默认
# chars    = 按实际合成字符数计费（清理后的量）—— 与 new-api 有 raw−sent 差额
# upstream = 按上游 character-cost 积分计费（透明模式，拿不到积分则退回 input）
ADAPTER_BILLING_MODE=input
ADAPTER_BILLING_LOG_DIR=logs/billing
ADAPTER_BILLING_LOG_DAYS=30
# =1 关闭账本写入（不建议：失败请求的凭据也一起没了）
ADAPTER_BILLING_LOG_OFF=0

# --- 毛利换算 ---
# ⚠️ 这两个数不填 = 不算毛利率（返回 null），填错 = 给出一个看着合理的错数。
# UP_CREDITS_PER_USD：ElevenLabs 积分兑美元。Creator 档 $22/100k ≈ 4545.45
# CHARS_PER_USD：我方售价，每美元卖多少字符。$0.08/千字符 → 12500
# 必须与 new-api 侧的模型倍率一致，否则算出来是「会计毛利率」
ADAPTER_UP_CREDITS_PER_USD=0
ADAPTER_CHARS_PER_USD=0

# --- 文本清理 ---
# off       = 只做换行规范化与首尾去空白
# safe      = 再去零宽字符/控制字符/连续空白（无损）★默认
# normalize = 在 safe 基础上再去 Markdown 标记
# ⚠️ 清理不改变计费基数：input 口径下清理掉的字符仍计入账单，
#    但上游只收清理后的量 —— 那是上游成本节省，不是计费折扣
ADAPTER_TEXT_CLEAN=safe
